    },
    {
      "id": "scheduling-scheduler",
      "category": "scheduling",
      "displayName": "Scheduling > New Scheduler",
      "templateFolder": "scheduling",
      "templateFile": "scheduler.hbs",
      "formType": "scheduler",
      "defaultFileName": {
        "xml": "context-scheduling-scheduler",
        "javaConfig": "EgovSchedulingSchedulerConfig"
      },
      "defaults": {
