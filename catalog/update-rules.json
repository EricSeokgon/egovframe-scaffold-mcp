  "changes": [
    {
      "id": "security-config-beans",
      "since": "5.0.1",
      "kind": "api",
      "classes": [
        "org.egovframe.rte.fdl.security.config.EgovSecurityConfiguration"
      ],
      "summary": "EgovSecurityConfiguration 의 @Bean 메서드 시그니처 변경",
      "reason": "authenticationManager(securityConfig, passwordEncoder)·usernamePasswordAuthenticationFilter(authenticationManager)·securityFilterChain(…, usernamePasswordAuthenticationFilter, securityConfig) 로 인자가 바뀌었다. 이 클래스를 상속하거나 메서드를 직접 호출하면 컴파일 오류가 난다. 또 roleHierarchy 가 null 대신 기본 계층(ROLE_ADMIN > ROLE_USER > ROLE_ANONYMOUS)을 돌려주고, 해시에 eccp·egov-sha256(아이디 솔트 SHA-256) 선택지가 생겼다.",
      "action": "manual",
      "evidence": {
        "fromTag": "v5.0.0-Final",
        "toTag": "v5.0.1-Final"
      }
    },
    {
      "id": "excel-formula-injection",
      "since": "5.0.1",
      "kind": "behavior",
      "classes": [
        "org.egovframe.rte.fdl.excel.util.AbstractExcelView",
        "org.egovframe.rte.fdl.excel.util.AbstractPOIExcelView"
      ],
      "summary": "엑셀 다운로드 셀 값의 수식 주입 방지",
      "reason": "문자열 셀 값이 = + - @ 탭·CR 로 시작하면 앞에 작은따옴표(')를 붙여 수식으로 해석되지 않게 한다(CSV/수식 주입 방지). 음수·수식을 문자열로 넣어 엑셀에서 계산되게 하던 화면은 결과가 달라지므로 숫자 셀(setCellValue(double))로 바꿔야 한다.",
      "action": "manual",
      "evidence": {
        "fromTag": "v5.0.0-Final",
        "toTag": "v5.0.1-Final"
      }
    },
    {
      "id": "xml-validator-xxe",
      "since": "5.0.1",
      "kind": "behavior",
      "classes": [
        "org.egovframe.rte.fdl.xml.EgovDOMValidatorService",
        "org.egovframe.rte.fdl.xml.EgovSAXValidatorService"
      ],
      "summary": "XML 검증에서 외부 엔티티·DTD 차단(XXE 방지)",
      "reason": "외부 일반·매개변수 엔티티와 외부 DTD 로딩을 막고 DOCTYPE 선언을 거부한다. DTD 를 참조하는 XML 을 검증하던 코드는 예외가 난다 — XSD 기반으로 바꾸거나 입력을 신뢰 경계 안에서만 다룬다.",
      "action": "manual",
      "evidence": {
        "fromTag": "v5.0.0-Final",
        "toTag": "v5.0.1-Final"
      }
    },
    {
      "id": "filehandling-path",
      "since": "5.0.1",
      "kind": "behavior",
      "classes": [
        "org.egovframe.rte.fdl.filehandling.EgovFileUtil"
      ],
