  "libraries": {
    "comment": "자동 좌표 치환으로 끝나지 않고 코드·설정 손질이 필요한 라이브러리. 항목별 사유를 그대로 보고한다.",
    "manual": [
      {
        "match": {
          "groupId": "commons-dbcp",
          "artifactId": "commons-dbcp"
        },
        "replacement": "org.apache.commons:commons-dbcp2",
        "reason": "DBCP 1.x 는 Java 17·Jakarta 환경에서 유지보수 종료. commons-dbcp2 로 바꾸고 BasicDataSource 패키지(org.apache.commons.dbcp2)와 속성명(maxActive→maxTotal, maxWait→maxWaitMillis)을 수정"
      },
      {
        "match": {
          "groupId": "log4j",
          "artifactId": "log4j"
        },
        "replacement": "org.apache.logging.log4j:log4j-core (또는 logback)",
        "reason": "Log4j 1.x 는 EOL(보안 취약). log4j2 또는 5.x 템플릿 기본인 logback 으로 옮기고 log4j.xml 설정을 변환"
      },
      {
        "match": {
          "groupId": "commons-fileupload",
          "artifactId": "commons-fileupload"
        },
        "replacement": "Servlet 3.0+ multipart(StandardServletMultipartResolver) 또는 org.apache.commons:commons-fileupload2-jakarta-servlet6",
        "reason": "commons-fileupload 1.x 는 javax.servlet 에 묶여 있어 Jakarta 에서 동작하지 않음. CommonsMultipartResolver 는 Spring 6 에서 제거됨"
      },
      {
        "match": {
          "groupId": "org.apache.tiles",
          "artifactId": "tiles-*"
        },
        "replacement": null,
        "reason": "Apache Tiles 는 종료된 프로젝트로 Jakarta 버전이 없고 Spring 6 에서 Tiles 지원이 제거됨. JSP include/레이아웃 태그 또는 Thymeleaf 로 대체"
      },
      {
        "match": {
          "groupId": "org.springframework",
          "artifactId": "spring-*",
          "versionBelow": "6.0.0"
        },
        "replacement": "Spring 6.x (5.x parent 가 관리)",
        "reason": "명시 버전이 6 미만. 5.x 템플릿처럼 parent 에 버전 관리를 맡기거나 6.x 로 올린다"
      },
      {
        "match": {
          "groupId": "org.springframework.security",
          "artifactId": "spring-security-*",
          "versionBelow": "6.0.0"
        },
        "replacement": "Spring Security 6.x",
        "reason": "Spring Security 6 에서 WebSecurityConfigurerAdapter·antMatchers 제거. SecurityFilterChain bean 방식으로 재작성"
      },
      {
        "match": {
          "groupId": "org.hibernate",
          "artifactId": "hibernate-validator",
          "versionBelow": "8.0.0"
        },
        "replacement": "org.hibernate.validator:hibernate-validator 8.x",
        "reason": "8.x 부터 jakarta.validation 을 구현. groupId 도 org.hibernate.validator 로 바뀜"
      },
      {
        "match": {
          "groupId": "org.hibernate.validator",
          "artifactId": "hibernate-validator",
          "versionBelow": "8.0.0"
        },
        "replacement": "org.hibernate.validator:hibernate-validator 8.x",
        "reason": "8.x 부터 jakarta.validation 을 구현"
      },
      {
        "match": {
          "groupId": "org.hibernate",
          "artifactId": "hibernate-core",
          "versionBelow": "6.0.0"
        },
        "replacement": "org.hibernate.orm:hibernate-core 6.x",
        "reason": "Hibernate 6 부터 jakarta.persistence 를 구현하며 groupId 가 org.hibernate.orm 으로 바뀜"
      },
      {
        "match": {
          "groupId": "org.mybatis",
          "artifactId": "mybatis-spring",
          "versionBelow": "3.0.0"
        },
        "replacement": "org.mybatis:mybatis-spring 3.x",
        "reason": "mybatis-spring 3.x 가 Spring 6 대상"
      },
      {
        "match": {
          "groupId": "org.apache.poi",
          "artifactId": "poi*",
          "versionBelow": "5.0.0"
        },
        "replacement": "org.apache.poi:poi 5.x",
        "reason": "fdl.excel 5.x 가 POI 5 를 사용. 3.x 시절 POI 3.x 는 API 가 다름(HSSF/XSSF 공통화)"
      },
      {
        "match": {
          "groupId": "egovframework.rte",
          "artifactId": "spring-modules-validation"
        },
        "replacement": "jakarta.validation:jakarta.validation-api + org.hibernate.validator:hibernate-validator",
        "reason": "5.x 실행환경에서 제외됨(Commons Validator 기반). 5.x 템플릿은 jakarta.validation 을 사용"
      },
      {
        "match": {
          "groupId": "org.egovframe.rte",
          "artifactId": "spring-modules-validation"
        },
        "replacement": "jakarta.validation:jakarta.validation-api + org.hibernate.validator:hibernate-validator",
        "reason": "5.x 실행환경에서 제외됨(Commons Validator 기반). 5.x 템플릿은 jakarta.validation 을 사용"
      },
      {
        "match": {
          "groupId": "junit",
          "artifactId": "junit"
        },
        "replacement": "org.junit.jupiter:junit-jupiter",
        "reason": "5.x 템플릿은 JUnit 5(Jupiter)·spring-test 6 을 사용. JUnit 4 는 vintage 엔진 없이는 실행되지 않음"
      }
    ]
  },
  "xmlNamespaces": {
    "comment": "Spring XML 설정에서 5.x 에 없는 커스텀 네임스페이스. spring.handlers 가 v4.3.0-Final 까지 있고 v5.0.2-Final 에는 없다.",
    "removed": [
      {
        "uri": "http://maven.egovframe.go.kr/schema/egov-access",
        "replacement": "org.egovframe.rte.fdl.access.config.EgovAccessConfiguration",
        "reason": "5.x 에서 egov-access 네임스페이스 제거. Java Config 로 전환"
      },
      {
        "uri": "http://maven.egovframe.go.kr/schema/egov-crypto",
        "replacement": "org.egovframe.rte.fdl.crypto.config.EgovCryptoConfiguration",
        "reason": "5.x 에서 egov-crypto 네임스페이스 제거. Java Config 로 전환"
      },
      {
        "uri": "http://maven.egovframe.go.kr/schema/egov-security",
        "replacement": "org.egovframe.rte.fdl.security.config.EgovSecurityConfiguration",
        "reason": "5.x 에서 egov-security 네임스페이스 제거. Java Config 로 전환"
      },
      {
        "uri": "http://www.springmodules.org/validation/bean/validator",
        "replacement": "jakarta.validation",
        "reason": "spring-modules-validation 이 5.x 실행환경에서 제외됨"
      }
    ]
  },
  "build": {
    "javaRelease": 17,
    "javaProperties": [
      "maven.compiler.source",
      "maven.compiler.target",
      "maven.compiler.release",
      "java.version"
    ],
    "springVersionProperties": [
      "spring.maven.artifact.version",
      "spring.maven.version",
      "spring.version",
      "spring-framework.version",
      "org.springframework-version",
      "springframework.version"
    ],
    "springMinimum": "6.0.0"
  }
}
