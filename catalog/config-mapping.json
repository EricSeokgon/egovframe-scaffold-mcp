        ]
      }
    },
    {
      "id": "transaction-datasource",
      "category": "transaction",
      "displayName": "Transaction > New Datasource Transaction",
      "templateFolder": "transaction",
      "templateFile": "datasource.hbs",
      "formType": "datasource",
      "defaultFileName": {
        "xml": "context-transaction",
        "javaConfig": "EgovTransactionConfig"
      },
      "defaults": {
        "txtConfigPackage": "egovframework.example.config",
        "txtTransactionName": "txManager",
        "txtDataSourceName": "dataSource",
        "chkAopConfigTransaction": true,
        "chkAnnotationTransaction": true,
        "txtPointCutName": "requiredTx",
        "txtPointCutExpression": "execution(* egovframework.example..*Impl.*(..)) || execution(* org.egovframe.rte.fdl.excel.impl.*Impl.*(..))",
        "txtAdviceName": "txAdvice",
        "txtMethodName": "*",
        "chkReadOnly": false,
        "txtRollbackFor": "Exception",
        "txtNoRollbackFor": "RuntimeException",
        "txtTimeout": "20",
        "cmbPropagation": "REQUIRED",
        "cmbIsolation": "DEFAULT",
        "txtTransactionTemplateName": "transactionTemplate"
      }
    },
    {
      "id": "transaction-jpa",
      "category": "transaction",
      "displayName": "Transaction > New JPA Transaction",
      "templateFolder": "transaction",
      "templateFile": "jpa.hbs",
      "formType": "jpa",
      "defaultFileName": {
        "xml": "context-transaction-jpa",
        "javaConfig": "EgovTransactionJpaConfig"
      },
      "defaults": {
        "txtConfigPackage": "egovframework.example.config",
        "txtTransactionName": "transactionManager",
        "txtEntityManagerFactory": "entityManagerFactory",
        "txtPackagesToScan": "egovframework.example.sample.domain",
        "cmbDialectName": "org.hibernate.dialect.H2Dialect",
        "txtSpringDataJpaRepositoriesPackage": "egovframework.example.sample.repository",
        "txtDataSourceName": "dataSource",
        "chkAopConfigTransaction": true,
        "chkAnnotationTransaction": true,
        "txtPointCutName": "requiredTx",
        "txtPointCutExpression": "execution(* egovframework.example..*Impl.*(..)) || execution(* org.egovframe.rte.fdl.excel.impl.*Impl.*(..))",
        "txtAdviceName": "txAdvice",
        "txtMethodName": "*",
        "chkReadOnly": false,
        "txtRollbackFor": "Exception",
        "txtNoRollbackFor": "RuntimeException",
        "txtTimeout": "20",
        "cmbPropagation": "REQUIRED",
        "cmbIsolation": "DEFAULT"
      }
    },
    {
      "id": "transaction-jta",
      "category": "transaction",
      "displayName": "Transaction > New JTA Transaction",
      "templateFolder": "transaction",
      "templateFile": "jta.hbs",
      "formType": "jta",
      "defaultFileName": {
        "xml": "context-transaction-jta",
        "javaConfig": "EgovTransactionJtaConfig"
      },
      "defaults": {
        "txtConfigPackage": "egovframework.example.config",
        "txtTransactionName": "transactionManager",
        "txtGlobalTimeout": "20",
        "chkAopConfigTransaction": true,
        "chkAnnotationTransaction": true,
        "txtPointCutName": "requiredTx",
        "txtPointCutExpression": "execution(* egovframework.example..*Impl.*(..)) || execution(* org.egovframe.rte.fdl.excel.impl.*Impl.*(..))",
        "txtAdviceName": "txAdvice",
        "txtMethodName": "*",
        "chkReadOnly": false,
        "txtRollbackFor": "Exception",
